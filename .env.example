# ==============================================================================
# TurboVault Environment Variables
# ==============================================================================
#
# Copy this file to .env and customize for your environment.
# (.env files are loaded automatically if present.)
#
# Usage:
#   cp .env.example .env
#   $EDITOR .env
#   source .env
#   turbovault
#
# Only the variables documented here are read by the `turbovault` binary
# today. Anything else you see in older versions of this file was
# aspirational and has been removed.
# ==============================================================================

# ------------------------------------------------------------------------------
# VAULT CONFIGURATION
# ------------------------------------------------------------------------------

# Path to the Obsidian vault to register as the "default" vault at startup.
# Equivalent to `turbovault --vault <path>`.
# Both `~` and `$HOME`-style references are shell-expanded.
# OBSIDIAN_VAULT_PATH=~/Documents/ObsidianVault

# ------------------------------------------------------------------------------
# CONFIGURATION FILE
# ------------------------------------------------------------------------------

# Path to the YAML config (see config.example.yaml). Equivalent to
# `turbovault --config <path>`. Both `~` and `$HOME` are shell-expanded.
# Holds the `vaults:` block (multiple vault configs) and the
# `tool_visibility:` block (tool allowlist/hidden/disabled).
# TURBOVAULT_CONFIG=~/.config/turbovault/config.yaml

# ------------------------------------------------------------------------------
# TOOL VISIBILITY (overrides config-file `tool_visibility:`)
# ------------------------------------------------------------------------------

# Comma-separated tool names — if set, ONLY these tools are listed/callable.
# TURBOVAULT_ALLOWED_TOOLS=read_note,write_note,edit_note,search

# Comma-separated tool names — hidden from tools/list but still callable by name.
# TURBOVAULT_HIDDEN_TOOLS=full_health_analysis

# Comma-separated tool names — removed from tools/list AND rejected on direct call.
# TURBOVAULT_DISABLED_TOOLS=delete_note

# Hide every tool not annotated as read-only by TurboMCP. Boolean.
# TURBOVAULT_REQUIRE_READ_ONLY_TOOLS=1

# ------------------------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------------------------

# env_logger-style filter string — same syntax `cargo run -- --help` documents
# for many Rust binaries (turbovault-foy lifted this from README claim to
# actual behavior).
#
# Priority:
#   RUST_LOG (this var)  ->  --profile production default  ->  --profile development default
#
# Examples:
# RUST_LOG=debug
# RUST_LOG=info,turbo_vault=debug
# RUST_LOG=warn,turbo_vault=trace,turbomcp=debug

# ==============================================================================
# Precedence (highest -> lowest):
#   1. CLI flags (--vault, --config, --allowed-tools, ...)
#   2. Environment variables (this file)
#   3. `--config` YAML file's `tool_visibility:` block
#   4. Built-in defaults
# ==============================================================================
