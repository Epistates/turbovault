# Global ignores
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.pyc
*.pyo
*.pyd
.coverage
htmlcov/
.DS_Store

# Environment
.env
.env.*
!.env.example

# Agent tooling state. Local to whoever is running it: settings, session
# scratch, and project state that means nothing in anyone else's checkout.
# `CLAUDE.md` itself stays tracked-by-hand at the repo root, since that is
# shared project instruction rather than local state.
.claude/

# Private strategy docs (keep untracked)
.strategy/
**/PRIVATE_*.md
**/*_CONFIDENTIAL.md
**/monetization*.md

/target*

# Exclude markdown files EXCEPT for documentation and README files
*.md
!README.md
!docs/**/*.md
!CHANGELOG.md
!CONTRIBUTORS.md
!CONTRIBUTING.md
!SECURITY.md
!CODE_OF_CONDUCT.md
# Issue and pull request templates.
!.github/**/*.md
!RELEASE*.md
!PUBLISH*.md
# Crate-level READMEs are packaged by Cargo (readme = "README.md"), so an
# ignored one ships as a broken reference on crates.io.
!crates/*/README.md
# Markdown test fixtures are inputs to the tests, not documentation. An ignored
# one is missing from a fresh clone, and `include_str!` turns that into a build
# failure rather than a skipped test.
!crates/*/tests/fixtures/*.md
# Fuzz seeds are inputs too, for the same reason.
!fuzz/seeds/**/*.md
!/LICENSE*
!LICENSE

# CycloneDX SBOMs from cargo-cyclonedx (generated in the release workflow)
*.cdx.json
